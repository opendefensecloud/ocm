# Registry credentials and signing. No resolvers — no component declares
# componentReferences.
#
# The credentials block is required: without it OCM requests a push token
# anonymously and ghcr answers 403. Implicit docker-config discovery only ever
# appeared to work because pulling public images needs no credentials at all.
#
# Sigstore keyless needs no secrets — on GitHub Actions the signing handler
# picks up the ambient OIDC token and forwards it to cosign.
#
# Only the SIGNER lives here. The verifier must be a separate file passed via
# --verifier-spec; a `verifier:` key in this block is silently ignored.
type: generic.config.ocm.software/v1
configurations:
  - type: credentials.config.ocm.software/v1
    repositories:
      - repository:
          type: DockerConfig/v1
          dockerConfigFile: ~/.docker/config.json

  - type: signing.config.ocm.software/v1alpha1
    signature: opendefense.cloud
    signer:
      type: SigstoreSigningConfiguration/v1alpha1
